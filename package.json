{
    "name": "@vallaboratory/mixway-shared-config",
    "version": "1.4.0",
    "description": "株式会社ヴァル研究所 mixway Teamが内部で利用する設定ファイルを配布するライブラリ",
    "type": "module",
    "scripts": {
        "fmt": "dprint fmt",
        "fmt:check": "dprint check",
        "check": "tsc",
        "lint": "npx eslint --flag unstable_native_nodejs_ts_config",
        "build": "tsdown"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "files": [
        "dist/"
    ],
    "exports": {
        "./eslint": {
            "types": "./dist/eslint/index.d.ts",
            "default": "./dist/eslint/index.js"
        },
        "./tsconfig": "./dist/tsconfig/tsconfig.json",
        "./dprint": "./dist/dprint/dprint.json",
        "./*": "./dist/*"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ValLaboratory/mixway-shared-config.git"
    },
    "keywords": [],
    "license": "MIT",
    "author": "ValLaboratory",
    "bugs": {
        "url": "https://github.com/ValLaboratory/mixway-shared-config/issues"
    },
    "homepage": "https://github.com/ValLaboratory/mixway-shared-config#readme",
    "dependencies": {
        "@eslint/compat": "^2.1.0",
        "@eslint/js": "^10.0.1",
        "@typescript-eslint/parser": "^8.62.0",
        "eslint-config-flat-gitignore": "^2.3.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-awscdk": "^4.3.3",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^63.0.13",
        "typescript-eslint": "^8.62.0"
    },
    "peerDependencies": {
        "@types/node": "*",
        "dprint": "*",
        "eslint": ">=10.0.0",
        "typescript": "^6.0.0"
    },
    "devDependencies": {
        "@types/node": "^24.13.3",
        "dprint": "^0.55.0",
        "eslint": "^10.6.0",
        "tsdown": "^0.22.3",
        "typescript": "^6.0.3"
    }
}
